APP_NAME=kode-app
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
# 骨架版本（与 composer.json 的 version 字段、git tag 三者保持一致）
APP_VERSION=1.1.9

LOG_LEVEL=debug
LOG_FORMAT=line

JWT_SECRET=__GENERATED_ON_INIT__ # php kode init 将自动替换为 bin2hex(random_bytes(32)) 强随机值
JWT_ALGO=HS256
JWT_TTL=3600
JWT_PLATFORM=web

# ------------------------------------------------------------------
# 数据库（统一 DB_* 命名，默认 pgsql 单连接；sqlite 仅本地零配置备用）
# ------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=
DB_POOL_ENABLED=false
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_MAX_WAIT=30
DB_POOL_MAX_IDLE=60
DB_SQLITE_PATH=
DB_AUTO_TRANSACTION=false
DB_LEAK_ROLLBACK=true
DB_RELEASE_PER_REQUEST=false

# ------------------------------------------------------------------
# 缓存 / Redis（CACHE_DRIVER=file|redis|array；队列/会话/限流共用 REDIS_* 连接参数）
# ------------------------------------------------------------------
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------
# 队列
# ------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_NAME=default
QUEUE_TABLE=jobs
QUEUE_FAILED_DRIVER=database
QUEUE_FAILED_PATH=
QUEUE_WORKER_NAME=kode-worker

# ------------------------------------------------------------------
# 会话
# ------------------------------------------------------------------
SESSION_ENABLED=false
SESSION_DRIVER=file
SESSION_NAME=KODE_SESSION
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_FILE_PATH=
SESSION_TABLE=sessions

# ------------------------------------------------------------------
# 服务
# ------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=9527
SERVER_WORKERS=0
SERVER_MAX_REQUEST=0
SERVER_REUSE_PORT=false
SERVER_NAME=kode-http
SERVER_GRACE_PERIOD=3
K8S_TERMINATION_GRACE_PERIOD=40

SECURITY_HEADERS_ENABLED=false
SESSION_SECURE=false

# ------------------------------------------------------------------
# 可观测性（指标 + 链路追踪）
# ------------------------------------------------------------------
OBS_METRICS_ENABLED=false
OBS_METRICS_PATH=/metrics
OBS_METRICS_MIDDLEWARE_ENABLED=true
OBS_METRICS_REGISTER_ENDPOINT=true
OBS_METRICS_PROTECT=token
OBS_METRICS_TOKEN=
OBS_METRICS_SAMPLE_RATIO=0.1
OBS_TRACING_ENABLED=false
OBS_TRACING_SAMPLE_RATIO=0.1
OBS_TRACING_FLUSH_ON_END=true
# 响应是否回写 W3C 链路头（traceparent + X-Trace-Id + X-Span-Id）。
# true（默认）：每个响应带链路头，网关/日志/APM 可直接串联；
# false：仅建立内部 trace 上下文（日志关联/下游串联/异常 tracer 桥接），不回写响应头，省去每请求开销。
OBS_TRACING_ATTACH_HEADERS=true
OBS_TRACING_ASYNC=true
OBS_TRACING_MAX_OUTBOX=4096
OBS_TRACING_FLUSH_INTERVAL_MS=2000
OBS_TRACING_MAX_BATCH=512
OBS_TRACING_EXPORTER=otlp_http
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTLP_TRACES_AUTH=
OTLP_TRACES_TIMEOUT=2
OBS_TRACING_FILE=
HEALTH_CHECK_DB=true
HEALTH_CHECK_CACHE=false
HEALTH_CHECK_QUEUE=false
ACCESS_LOG_ENABLED=false
ACCESS_LOG_ASYNC=true

# ------------------------------------------------------------------
# 安全（CORS / CSRF / 安全头）
# ------------------------------------------------------------------
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CSRF_ENABLED=false
CSRF_TOKEN_KEY=_csrf_token
CSRF_HEADER=X-CSRF-Token
CSRF_XSRF_HEADER=X-XSRF-Token
CSRF_TOKEN_PARAM=_token
CSRF_ERROR_STATUS=419
CSRF_ERROR_MESSAGE=CSRF token mismatch
CSRF_AUTO_APPLY_UNSAFE=false
CSRF_AUDIT_ON_FAILURE=true
CSRF_AUDIT_ACTION=csrf.failed
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HSTS=max-age=31536000; includeSubDomains
SECURITY_REQUEST_ID=false
SECURITY_REQUEST_ID_ALLOW_CLIENT=true
SECURITY_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
SECURITY_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=(), payment=(), usb=()
SECURITY_COOP=same-origin
SECURITY_CORP=same-origin
SECURITY_COEP=false
# 受信反向代理（逗号分隔，支持精确 IP 与 CIDR；为空=不信任任何代理，只用 REMOTE_ADDR）
TRUSTED_PROXIES=

# ------------------------------------------------------------------
# 韧性（限流 / 熔断 / 重试 / 超时 / 锁 / 幂等）
# ------------------------------------------------------------------
LIMITING_ENABLED=false
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_GLOBAL=false
RATE_LIMIT_CAPACITY=1000
RATE_LIMIT_RATE=1.0
RATE_LIMIT_ALGO=token_bucket
REDIS_MODE=standalone
REDIS_SENTINELS=127.0.0.1:26379
REDIS_MASTER=mymaster
REDIS_CLUSTER_NODES=127.0.0.1:7000
REDIS_PREFIX=kode:limiting:
RATE_LIMIT_PDO_DSN=sqlite::memory:
RATE_LIMIT_PDO_USER=
RATE_LIMIT_PDO_PASS=
RATE_LIMIT_PDO_TABLE=limiting
RATE_LIMIT_MEMCACHED_HOST=127.0.0.1
RATE_LIMIT_MEMCACHED_PORT=11211
RATE_LIMIT_MEMCACHED_PREFIX=kode:limiting:
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_TIMEOUT=30.0
BREAKER_HALF_OPEN_CALLS=1
BREAKER_HTTP_ENABLED=false
BREAKER_HTTP_SERVICE=
BREAKER_HTTP_DERIVE=path
BREAKER_HTTP_STATUS_THRESHOLD=500
BREAKER_HTTP_OPEN_STATUS=503
BREAKER_HTTP_EXCLUDE=/health,/health/ready,/metrics,/favicon.ico
RETRY_ATTEMPTS=3
RETRY_BACKOFF=exponential
RETRY_BACKOFF_BASE=0.1
RETRY_BACKOFF_CAP=10.0
RETRY_BACKOFF_JITTER=true
RETRY_HTTP_ENABLED=false
RETRY_HTTP_METHODS=GET,HEAD,PUT,DELETE,OPTIONS
RETRY_HTTP_ATTEMPTS=3
RETRY_HTTP_TIMEOUT=
RETRY_HTTP_STATUS=502,503,504
TIMEOUT_SECONDS=5.0
TIMEOUT_SCHEDULER=auto
TIMEOUT_THROW=true
LOCK_DRIVER=memory
LOCK_PATH=
LOCK_WATCHDOG_ENABLED=true
LOCK_WATCHDOG_DRIVER=auto
LOCK_WATCHDOG_RENEW_RATIO=0.34
IDEMPOTENCY_DRIVER=memory
IDEMPOTENCY_PATH=
IDEMPOTENCY_HTTP_ENABLED=false
IDEMPOTENCY_HEADER=Idempotency-Key
IDEMPOTENCY_ENFORCE=false
IDEMPOTENCY_TTL=3600
IDEMPOTENCY_SCOPE=global
IDEMPOTENCY_PREFIX=
IDEMPOTENCY_REPLAY_HEADER=Idempotency-Replay
IDEMPOTENCY_RECORDED_HEADER=Idempotency-Recorded

# ------------------------------------------------------------------
# 扩展能力（特性开关 / 多租户 / 消息 / 并发 / 定时 / 配置中心 / 服务发现 / 审计 / 本地化）
# ------------------------------------------------------------------
FEATURE_ENABLED=false
FEATURE_DEFAULT=false
TENANT_ENABLED=false
TENANT_RESOLVER=
TENANT_DEFAULT=
TENANT_HEADER=X-Tenant-Id
TENANT_BASE_DOMAIN=
TENANT_STORAGE_ENABLED=false
TENANT_STORAGE_STRATEGY=shared
TENANT_STORAGE_TEMPLATE=pgsql
TENANT_DB_PREFIX=tnt_
TENANT_STORAGE_ON_MISSING=fallback
MESSAGING_DEFAULT=memory
MESSAGING_TRANSPORT=auto
PARALLEL_ENABLED=true
PARALLEL_BOOTSTRAP=
PARALLEL_ENGINE=
PARALLEL_CONCURRENCY=0
SCHEDULE_DISCOVER_PLUGINS=false
SCHEDULE_CLUSTER_STORE=
SCHEDULE_CLUSTER_TTL=30
CONFIG_CENTER_ENABLED=false
CONFIG_CENTER_FILE=
SERVICE_DISCOVERY_ENABLED=true
SERVICE_DISCOVERY_STRATEGY=round_robin
EXAMPLE_UPSTREAM_HOST=127.0.0.1
EXAMPLE_UPSTREAM_PORT=8080
AUDIT_ENABLED=false
AUDIT_CAPTURE_USER=true
AUDIT_LOG_LEVEL=info
AUDIT_EVENT_LOG_LEVEL=info
AUDIT_MASK_BODY=false
AUDIT_FORENSIC=true
APP_LOCALE=zh-CN
API_VERSIONING_ENABLED=false
API_VERSIONING_REQUIRED=true
API_VERSION=v1
API_SUPPORTED_VERSIONS=v1
API_DOC_TOKEN=
AOP_ENABLED=true
AOP_CACHE_PATH=
AOP_STRICT=false
HTTP_CLIENT_BASE_URI=
HTTP_CLIENT_TIMEOUT=5.0
HTTP_JSON_STRICT=false
HTTP_PRODUCTION_MESSAGE=系统繁忙，请稍后重试
# 对外 ID 混淆盐（各环境独立生成，轮换后旧 eid 失效）
HASHID_SALT=change-me-hashid-salt
# API 签名密钥（对外重要接口 HMAC 用，各环境独立强随机）
API_SIGN_SECRET=change-me-api-sign-secret
# 远程插件市场：允许内网地址（本地联调 true，生产 false）
MARKET_ALLOW_PRIVATE=false
# 读写分离 / 分片（生产按拓扑填写）
DB_READ_WRITE_SPLIT=false
SHARD_ENABLED=false
# C 端自助注册开关
C_API_REGISTER=false
SNOWFLAKE_WORKER_ID=0
SNOWFLAKE_EPOCH=1704067200000
